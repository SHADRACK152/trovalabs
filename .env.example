# Copy this file to `.env` and fill in secrets
# Example .env for Lumino-ai

# Database (Neon/Postgres)
# Example: postgresql://user:password@host:port/dbname
DATABASE_URL=

# Hugging Face API key (optional, for hosted image generation)
HF_API_KEY=
HF_IMAGE_MODEL=

# OpenAI API key (optional fallback for images)
OPENAI_API_KEY=

# Other optional keys
GROQ_API_KEY=
REPLICATE_API_TOKEN=
