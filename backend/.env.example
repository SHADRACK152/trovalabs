# Lumino AI Backend Configuration
# Copy this file to .env and fill in your API keys

# ====================
# LLM Provider (Required)
# ====================

# Option 1: Groq (FREE & FAST - Recommended!)
# Get FREE key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI (Paid)
# OPENAI_API_KEY=your_openai_api_key_here

# ====================
# Vision/Image Analysis (Optional)
# ====================

# Google Gemini Vision (FREE!)
# Get FREE key at: https://aistudio.google.com/app/apikey
# 15 requests/min, 1500 requests/day - Perfect for image analysis
GOOGLE_API_KEY=your_google_api_key_here

# ====================
# Voice Cloning (Optional)
# ====================

# ElevenLabs Voice Cloning (Optional - for premium voices)
# Get key at: https://elevenlabs.io
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ====================
# Model Configuration
# ====================

# LLM Model Selection
# Groq models: llama-3.1-8b-instant, llama-3.3-70b-versatile, mixtral-8x7b-32768
LLM_MODEL=llama-3.1-8b-instant

# Vision Model (Google Gemini)
VISION_MODEL=gemini-2.5-flash

# ASR (Speech Recognition) Provider
# Options: groq_whisper (FREE & FAST!), speech_recognition (free), openai_whisper
ASR_PROVIDER=groq_whisper

# TTS (Text-to-Speech) Provider
# Options: gtts (free), openai (paid)
TTS_PROVIDER=gtts

# ====================
# Server Settings
# ====================

HOST=0.0.0.0
PORT=8000
DEBUG=True
